node_modules/
dist/
*.log
data/*.db
data/*.db-*
data/uploads/
.env
test-results/
playwright-report/
docs/review-pack/
.vite/
.claude/

.vercel
# `vercel link` appends a blanket `.env*` here, which also hides .env.example —
# the one env file that is meant to be committed. Enumerate instead.
.env.local
.env.*.local
# Timestamped .env backups. One of these was committed by an `add -A` and pushed
# with the gateway key in it, so the pattern is named here rather than left to
# whoever is next to notice.
.env.bak-*
.playwright-mcp/

# Agent scratch/debug scripts — never part of the app
__*.mjs

# Landing-page review screenshots - regenerate with scripts/capture-landing.mjs
docs/landing-review*/

# tesseract.js runtime assets - copied from node_modules by web/scripts/vendor-tesseract.mjs
# at pre(dev|build). ~7MB of binaries that npm already pins; never commit them.
web/public/tesseract/
